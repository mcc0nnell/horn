{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/horn/0.2/horn.schema.json",
  "title": "HORN 0.2 Canonical IR",
  "type": "object",
  "required": [
    "horn",
    "debates"
  ],
  "properties": {
    "horn": {
      "const": "0.2"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "default": []
    },
    "passages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/passage"
      },
      "default": []
    },
    "debates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/debate"
      }
    },
    "spaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/space"
      },
      "default": []
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "source": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "year": {
          "type": "integer"
        },
        "uri": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "passage": {
      "type": "object",
      "required": [
        "id",
        "source",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/id"
        },
        "locator": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "required": [
        "id",
        "type",
        "question"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "fact",
            "action",
            "terminology",
            "ethics",
            "law",
            "goal",
            "means",
            "explanation"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "alias": {
          "type": "string"
        },
        "role": {
          "enum": [
            "position",
            "ground",
            "warrant",
            "backing",
            "rebuttal"
          ]
        },
        "derivation": {
          "enum": [
            "extracted",
            "summarized",
            "synthesized",
            "inferred"
          ]
        },
        "editorial_state": {
          "enum": [
            "draft",
            "review",
            "publishable"
          ]
        },
        "evidence_state": {
          "enum": [
            "missing",
            "partial",
            "grounded",
            "verify"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "default": []
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "kind",
        "from",
        "to"
      ],
      "properties": {
        "kind": {
          "enum": [
            "supports",
            "disputes"
          ]
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "stream": {
      "type": "object",
      "required": [
        "id",
        "claims"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "definition",
            "history",
            "presupposition",
            "proposal",
            "editorial_note"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "default": []
        }
      },
      "additionalProperties": false
    },
    "display": {
      "type": "object",
      "properties": {
        "title_mode": {
          "enum": [
            "title_is_claim",
            "topic_title"
          ],
          "default": "title_is_claim"
        }
      },
      "additionalProperties": false
    },
    "debate": {
      "type": "object",
      "required": [
        "id",
        "issue",
        "focus",
        "claims"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "issue": {
          "$ref": "#/$defs/issue"
        },
        "focus": {
          "$ref": "#/$defs/id"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          },
          "default": []
        },
        "streams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stream"
          },
          "default": []
        },
        "context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/context"
          },
          "default": []
        },
        "subdebates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/debate"
          },
          "default": []
        },
        "display": {
          "$ref": "#/$defs/display"
        }
      },
      "additionalProperties": false
    },
    "arena": {
      "type": "object",
      "required": [
        "id",
        "debates"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "debates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "space": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "debates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "default": []
        },
        "arenas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/arena"
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  }
}
