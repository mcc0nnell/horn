{
  "name": "horn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "check": "npm run typecheck && npm test",
    "horn-zeppelin": "tsx src/zeppelin/cli.ts",
    "render": "tsx src/cli/render.ts",
    "render:celix": "tsx src/cli/render.ts maps/celix-845-specimen-001.horn.json",
    "trace": "tsx src/cli/trace.ts",
    "trace:celix": "tsx src/cli/trace.ts maps/celix-845-specimen-001.horn.json c6-safe-default",
    "analyze": "tsx src/cli/analyze.ts",
    "query": "tsx src/cli/query.ts",
    "invalidate": "tsx src/cli/invalidate.ts",
    "invalidate:celix": "tsx src/cli/invalidate.ts experiments/celix-845/evidence/sbom-physical-evidence.json experiments/celix-845/evidence/bindings.json",
    "validate:report": "tsx src/cli/validate-report.ts",
    "golden:validation": "node golden/validation/compare.mjs"
  },
  "dependencies": {
    "echarts": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
