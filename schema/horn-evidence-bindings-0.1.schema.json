{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcc0nnell/horn/schema/horn-evidence-bindings-0.1.schema.json",
  "title": "Horn evidence bindings artifact",
  "type": "object",
  "required": ["version", "id", "document", "bindings", "semantics"],
  "properties": {
    "version": { "const": "horn-evidence-bindings/0.1" },
    "id": { "type": "string", "minLength": 1 },
    "document": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "const": "horn-document/0.1" }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidenceId", "nodeIds", "expectedFingerprint", "rationale"],
        "properties": {
          "evidenceId": { "type": "string", "minLength": 1 },
          "nodeIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "expectedFingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "rationale": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "semantics": { "type": "string", "minLength": 1 },
    "extensions": {
      "type": "object",
      "patternProperties": { "^x-.+": {} },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
