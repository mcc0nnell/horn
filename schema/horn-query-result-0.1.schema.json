{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcc0nnell/horn/schema/horn-query-result-0.1.schema.json",
  "title": "Horn deterministic query result",
  "type": "object",
  "required": [
    "version",
    "requestVersion",
    "operation",
    "source",
    "result"
  ],
  "properties": {
    "version": { "const": "horn-query-result/0.1" },
    "requestVersion": { "const": "horn-query-request/0.1" },
    "operation": {
      "enum": ["graph", "counterfactual", "dominators"]
    },
    "source": {
      "type": "object",
      "required": ["documentId", "documentVersion"],
      "properties": {
        "documentId": { "type": "string", "minLength": 1 },
        "documentVersion": { "const": "horn-document/0.1" }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
