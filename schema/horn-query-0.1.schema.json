{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcc0nnell/horn/schema/horn-query-0.1.schema.json",
  "title": "Horn query request",
  "type": "object",
  "required": ["op"],
  "properties": {
    "version": { "const": "horn-query/0.1" },
    "op": {
      "type": "string",
      "enum": [
        "node-lookup",
        "relation-lookup",
        "neighborhood",
        "reachable",
        "ancestors",
        "descendants",
        "support-path",
        "challenge-path",
        "frontier",
        "evidence-bound",
        "provenance-trace",
        "orphans",
        "counterfactual"
      ]
    },
    "id": { "type": "string", "minLength": 1 },
    "from": { "type": "string", "minLength": 1 },
    "to": { "type": "string", "minLength": 1 },
    "direction": {
      "type": "string",
      "enum": ["inbound", "outbound", "both", "semantic", "reading"]
    },
    "kinds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "suppress": {
      "type": "object",
      "properties": {
        "nodes": { "type": "array", "items": { "type": "string" } },
        "relations": { "type": "array", "items": { "type": "string" } },
        "evidenceBindings": { "type": "array" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
