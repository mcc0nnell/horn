{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcc0nnell/horn/schema/horn-evidence-snapshot-0.1.schema.json",
  "title": "Horn evidence snapshot artifact",
  "type": "object",
  "required": ["version", "id", "substrate", "interpretationBoundary"],
  "properties": {
    "version": { "const": "horn-evidence-snapshot/0.1" },
    "id": { "type": "string", "minLength": 1 },
    "substrate": {
      "type": "object",
      "required": ["components", "dependencyGraph"],
      "properties": {
        "components": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "dependencyGraph": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      },
      "additionalProperties": false
    },
    "interpretationBoundary": { "type": "string", "minLength": 1 },
    "extensions": {
      "type": "object",
      "patternProperties": { "^x-.+": {} },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
